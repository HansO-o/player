{
  "name": "@hanso-o/player",
  "version": "0.1.0",
  "description": "Native-first HEVC and AV1 browser player with real WebAssembly audio/video fallback",
  "type": "module",
  "license": "GPL-3.0-or-later",
  "main": "./dist/lib/player.js",
  "module": "./dist/lib/player.js",
  "exports": { ".": "./dist/lib/player.js" },
  "files": ["dist/lib", "public/vendor", "src", "scripts", "docs", "demo", "index.html", "vite.config.js", "README.md", "LICENSE"],
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "assets": "node scripts/prepare-assets.mjs",
    "dev": "npm run assets && vite --host 0.0.0.0",
    "build": "npm run assets && node scripts/build.mjs",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
    "test": "node --test test/*.test.js",
    "test:e2e": "playwright test",
    "fixtures": "node scripts/generate-fixtures.mjs",
    "check": "npm test && npm run build",
    "prepack": "npm run build"
  },
  "dependencies": { "@libmedia/avplayer": "1.3.1" },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "vite": "8.3.8"
  }
}
